# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Medical Coding & Claims Automation System
VERSION=1.0.0

# Security
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql://medical_user:medical_password@localhost:5432/medical_coding

# OpenAI / LLM
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=[".pdf",".txt",".docx"]

# MCP
MCP_SERVER_URL=
